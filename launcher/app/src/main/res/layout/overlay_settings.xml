<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EB080A0E"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSettingsClose"
                        style="@style/TopButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:gravity="center"
                        android:text="←"
                        android:textSize="18sp"
                        android:nextFocusLeft="@id/btnSettingsClose"
                        android:nextFocusRight="@id/btnTopStyleText"
                        android:nextFocusUp="@id/btnSettingsClose"
                        android:nextFocusDown="@id/btnTopStyleText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="-0.02"
                        android:text="Settings &amp; Customization"
                        android:textColor="#FFFFFFFF"
                        android:textSize="26sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="#2E38BDF8"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="TV-VIBEHACK"
                        android:textColor="#38BDF8"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="58dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 300"
                    android:text="Interface style, dock depth, wallpaper and system preferences"
                    android:textColor="#80FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Two Columns of Setting Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Left Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <!-- Card 1: Üst Bar Stili -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="Top Bar Style"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:fontFamily="@font/outfit"
                        android:text="Appearance of Calendar, Devices, and status pills"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnTopStyleText"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="🏷️ Text + Icon"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="14sp"
                            android:nextFocusDown="@+id/btnPeekUltra" />

                        <TextView
                            android:id="@+id/btnTopStyleIcon"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="🔘 Icon Only"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="14sp"
                            android:nextFocusDown="@+id/btnPeekUltra" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 2: Dock Gizlenme Seviyesi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="Dock Peek Behavior"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:fontFamily="@font/outfit"
                        android:text="Hide depth when dock is not focused"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnPeekUltra"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="🔻 Ultra Low (95%)"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusUp="@+id/btnTopStyleText" />

                        <TextView
                            android:id="@+id/btnPeekBalanced"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="↔️ Balanced (Half)"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusUp="@+id/btnTopStyleText" />

                        <TextView
                            android:id="@+id/btnPeekNone"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="⬆️ Always Visible"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusUp="@+id/btnTopStyleText" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Right Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <!-- Card 3: Wallpaper Theme -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="Wallpaper Cycle"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:fontFamily="@font/outfit"
                        android:text="Day and night ambient solar lighting"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnWallAuto"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="🌗 Automatic"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusDown="@+id/btnSysSettings" />

                        <TextView
                            android:id="@+id/btnWallDay"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="☀️ Day"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusDown="@+id/btnSysSettings" />

                        <TextView
                            android:id="@+id/btnWallNight"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="🌙 Night"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusDown="@+id/btnSysSettings" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 4: System Shortcuts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="System Shortcuts"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:fontFamily="@font/outfit"
                        android:text="Device, network, and application management"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnSysSettings"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="⚙️ Settings"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusUp="@+id/btnWallAuto" />

                        <TextView
                            android:id="@+id/btnSysWifi"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="📶 Wi-Fi"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusUp="@+id/btnWallAuto" />

                        <TextView
                            android:id="@+id/btnSysApps"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="📱 Apps"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp"
                            android:nextFocusUp="@+id/btnWallAuto" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
